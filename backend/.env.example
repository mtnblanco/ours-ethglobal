# Environment Configuration for Ours Backend

# Server Configuration
PORT=8000
NODE_ENV=development

# Worldcoin Configuration (Only APP_ID needed for MiniKit verification)
WORLDCOIN_APP_ID=app_your_app_id_here

# World Chain Configuration  
WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.gateway.tenderly.co
PRIVATE_KEY=your_private_key_here

# Smart Contract
CHAINLINK_KYC_ISSUER_CONTRACT_ADDRESS=your_deployed_contract_address_here

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# API Configuration
API_VERSION=v1